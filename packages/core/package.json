{
  "name": "@openreloading/buildguide",
  "version": "0.2.5",
  "description": "Interactive build guides for hardware: BOM checklist, wiring and tubing boards from one JSON file",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/BuildGuide.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "bin": {
    "buildguide-check": "src/buildguide-check.mjs"
  },
  "files": [
    "src",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info tests/*.test.mjs",
    "test:browser": "playwright test",
    "serve": "node tests/serve.mjs 8080",
    "dist": "node scripts/dist.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  }
}
