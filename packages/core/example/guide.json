        { "id": "C", "title": "Valve", "connections": [
          { "no": "7", "a": "F1:2", "b": "K1:11", "color": "RD", "size": "0.5 mm²" },
          { "no": "8", "a": "K1:14", "b": "Y1:1", "color": "RD", "cable": "Valve cable", "size": "2 x 0.5 mm²" },
          { "no": "9", "a": "Y1:2", "b": "X1:3", "color": "BK", "cable": "Valve cable", "size": "2 x 0.5 mm²" },
          { "no": "D1", "a": "Y1:1", "b": "Y1:2", "color": "DIODE", "la": "Valve Y1 · 1 (+)", "lb": "Valve Y1 · 2" }
        ] },
        { "id": "D", "title": "Sensor", "connections": [
          { "no": "10", "a": "B1:BN", "b": "K1:11", "color": "BN", "cable": "Sensor cable", "size": "3 x 0.25 mm²" },
          { "no": "11", "a": "B1:BU", "b": "X1:4", "color": "BU", "cable": "Sensor cable", "size": "3 x 0.25 mm²" },
          { "no": "12", "a": "B1:BK", "b": "K1:A1", "color": "BK", "cable": "Sensor cable", "size": "3 x 0.25 mm²" }
        ] }
      ]
    },
    "tubing": {
      "title": "Tubing",
      "label": "Tubing diagram",
      "size": [1000, 420],
      "prefix": "tube",
      "scope": "all",
      "listAll": true,
      "listColor": false,
      "legend": ["6 x 4 mm tube · schematic", "Green = selected connection"],
      "colors": { "AIR": { "line": "#7694b2", "outline": "#3f5f7f" } },
      "parts": {
        "AIR": { "name": "Air supply", "sub": "6 bar", "at": [40, 160], "size": [110, 70], "ports": { "right": ["out"] } },
        "REG": { "name": "Regulator", "sub": "IN → OUT", "at": [240, 160], "size": [110, 70], "ports": { "left": ["in"], "right": ["out"] } },
        "V1": { "name": "5/2 valve", "sub": "Y1", "at": [460, 200], "size": [180, 80], "ports": { "left": ["P"], "top": ["A", "B"], "bottom": ["R", "S"] } },
        "CYL": { "name": "Cylinder", "sub": "double acting", "at": [760, 50], "size": [180, 60], "ports": { "bottom": ["cap", "rod"] } },
        "SIL": { "name": "Silencers", "at": [500, 360], "size": [100, 30], "ports": { "top": ["R", "S"] } }
      },
      "steps": [
        { "id": "1", "title": "Supply to regulator", "connections": [{ "no": "1", "a": "AIR:out", "b": "REG:in", "color": "AIR", "la": "Air supply", "lb": "Regulator IN" }] },
        { "id": "2", "title": "Regulator to valve", "connections": [{ "no": "2", "a": "REG:out", "b": "V1:P", "color": "AIR", "la": "Regulator OUT", "lb": "Valve P" }] },
        { "id": "3", "title": "Valve A to cap end", "connections": [{ "no": "3", "a": "V1:A", "b": "CYL:cap", "color": "AIR", "la": "Valve A", "lb": "Cylinder cap end" }] },
        { "id": "4", "title": "Valve B to rod end", "connections": [{ "no": "4", "a": "V1:B", "b": "CYL:rod", "color": "AIR", "la": "Valve B", "lb": "Cylinder rod end" }] },
        { "id": "5", "title": "Exhaust R", "connections": [{ "no": "5", "a": "V1:R", "b": "SIL:R", "color": "AIR", "la": "Valve R", "lb": "Silencer R" }] },
        { "id": "6", "title": "Exhaust S", "connections": [{ "no": "6", "a": "V1:S", "b": "SIL:S", "color": "AIR", "la": "Valve S", "lb": "Silencer S" }] }
