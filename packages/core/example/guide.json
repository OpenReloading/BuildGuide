          { "no": "4", "a": "S0:2", "b": "S1:3", "color": "RD", "size": "0.5 mm²" },
          { "no": "5", "a": "S1:4", "b": "K1:A1", "color": "RD", "size": "0.5 mm²" },
          { "no": "6", "a": "K1:A2", "b": "X1:2", "color": "BK", "size": "0.5 mm²" }
