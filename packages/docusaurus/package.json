{
  "name": "@openreloading/docusaurus-plugin-buildguide",
  "version": "1.5.1",
  "description": "Docusaurus plugin for BuildGuide: interactive build guides (BOM checklist, wiring and tubing boards) from one JSON file",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/BuildGuide.git",
    "directory": "packages/docusaurus"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "core"
  ],
  "scripts": {
    "compile": "npm run build -w @openreloading/buildguide && node scripts/copy-core.mjs && tsc -b",
    "test": "npm run compile && node --test --enable-source-maps --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info tests/*.test.mjs",
    "build": "npm run compile && docusaurus build example",
    "start": "npm run compile && docusaurus start example --host 0.0.0.0 --port 8080",
    "prepack": "npm run compile",
    "dist": "mkdir -p dist && npm pack --pack-destination dist"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "copy-webpack-plugin": "^14.0.0"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.6.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "types": "lib/index.d.ts"
}
