{
  "name": "@openreloading/docusaurus-plugin-buildguide",
  "version": "1.5.1",
  "description": "Docusaurus plugin for BuildGuide: interactive build guides (BOM checklist, wiring and tubing boards) from one JSON file",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/BuildGuide.git",
    "directory": "packages/docusaurus"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "core"
  ],
  "scripts": {
    "test": "node scripts/copy-core.mjs && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info tests/*.test.mjs",
    "build": "node scripts/copy-core.mjs && docusaurus build example",
    "start": "node scripts/copy-core.mjs && docusaurus start example --host 0.0.0.0 --port 8080",
    "prepack": "node scripts/copy-core.mjs",
    "dist": "mkdir -p dist && npm pack --pack-destination dist"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "copy-webpack-plugin": "^14.0.0"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.6.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
