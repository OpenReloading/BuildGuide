{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    // @docusaurus/useGlobalData and the other aliases the site's bundler resolves; like the Node part, their declarations pull in
    // React, MDX and bundler declarations that do not check on their own
    "types": ["@docusaurus/module-type-aliases"],
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "lib",
    "tsBuildInfoFile": ".tsbuild/client.tsbuildinfo"
  },
  // core's global declarations, copied into core/, type window.BuildGuide
  "files": ["src/theme/BuildGuide/index.ts", "core/buildguide.d.ts"]
}
