{
  "compilerOptions": {
    // @docusaurus/tsconfig without its baseUrl, which TypeScript 7 no longer has
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // Node runs the scripts with their .mts imports as written
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "scripts", "src", "tests"]
}
