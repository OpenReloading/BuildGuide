{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!.agents", "!.claude", "!**/vendor", "!**/dist"]
  },
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "noUnusedVariables": "error", "noUnusedImports": "error", "noUndeclaredDependencies": "error" },
      "suspicious": { "noNestedPromises": "error", "useArraySortCompare": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/**", "!packages/core/src/buildguide-check.mts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": { "patterns": [{ "group": ["node:*", "node:*/**"], "message": "The browser library runs without Node." }] }
            }
          }
        }
      }
    }
  ],
  "assist": { "enabled": false }
}
